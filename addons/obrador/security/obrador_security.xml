<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_obrador" model="res.groups.privilege">
        <field name="name">Obrador</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_obrador_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_obrador"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Carga partes diarios (avance, materiales y equipos) de las obras en curso.</field>
    </record>

    <record id="group_obrador_responsable" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_obrador"/>
        <field name="implied_ids" eval="[Command.link(ref('group_obrador_usuario'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Administra obras y equipos, y confirma o reabre los partes diarios.</field>
    </record>
</odoo>
